generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String                 @id @default(cuid())
  nameHe        String
  sortOrder     Int                    @default(0)
  products      Product[]              @relation("ProductCategories")
  productOrders CategoryProductOrder[]
  promotionItems PromotionItem[]
}

model CategoryProductOrder {
  id         String   @id @default(cuid())
  categoryId String
  productId  String
  sortOrder  Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([categoryId, productId])
}

model Product {
  id            String         @id @default(cuid())
  nameHe        String
  descriptionHe String         @default("")
  detailsHe     String         @default("")
  price         Float          @default(150)
  comparePrice  Float?
  stock         Int            @default(0)
  image         String         @default("")
  active        Boolean        @default(true)
  sizeGuideImages String?
  /// null = follow the store-wide setting. The cm table only fits garments,
  /// so shoe products turn it off without hiding it everywhere.
  showSizeChart Boolean?
  /// The product's own tag on its card, apart from any promotion's tag.
  /// badgeText null = no tag.
  badgeText     String?
  badgeColor    String         @default("#111111")
  /// "sm" | "md" | "lg"
  badgeSize     String         @default("md")
  /// "top-right" | "top-left" | "bottom-right" | "bottom-left"
  badgePosition String         @default("top-left")
  categories    Category[]     @relation("ProductCategories")
  categoryOrders CategoryProductOrder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
  images        ProductImage[]
  colors        ProductColor[]
  promotionItems PromotionItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColor {
  id         String              @id @default(cuid())
  productId  String
  nameHe     String
  hex        String              @default("#000000")
  stock      Int                 @default(0)
  sortOrder  Int                 @default(0)
  imageUrl   String?
  linkedUrl  String?
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductColorImage[]
  sizes      ProductColorSize[]
}

model ProductColorSize {
  id        String       @id @default(cuid())
  colorId   String
  /// Free-form label: "M", "42", "34/32". Order comes from sortOrder, not the label.
  size      String
  stock     Int          @default(0)
  sortOrder Int          @default(0)
  color     ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([colorId, size])
}

model ProductColorImage {
  id        String       @id @default(cuid())
  colorId   String
  url       String
  sortOrder Int          @default(0)
  color     ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  floor         String?
  apartment     String?
  city          String
  items         OrderItem[]
  subtotal      Float
  delivery      Float       @default(40)
  total         Float
  status        String      @default("pending")
  orderStage    String      @default("received")
  paymentId     String?
  shipmentNumber      String?
  shipmentRandId      String?
  pudoCodeDestination String?
  pudoPointName       String?
  deliveryMode        String?
  couponCode          String?
  /// The creator code this order is credited to — kept even when couponCode
  /// is not, since a promotion can stop the code from discounting anything.
  collabCode          String?
  /// The creator's commission on this order, fixed when it was placed.
  collabCommission    Float?
  /// When the admins were texted that this order is still unpaid, so each
  /// stuck order is reported once.
  pendingAlertAt      DateTime?
  /// Flagged by an admin in the orders list, e.g. to come back to it.
  starred             Boolean   @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([collabCode])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  size      String
  color     String?
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model AdminPhone {
  id        String   @id @default(cuid())
  phone     String   @unique
  label     String?
  /// Gets the "new order" SMS (and other order alerts). When no number has
  /// this on, those texts fall back to ADMIN_PHONE.
  orderSms  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminOtp {
  phone     String   @id
  code      String
  expiresAt DateTime
  /// Wrong guesses against this code; at MAX_OTP_ATTEMPTS it stops working.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteConfig {
  key   String @id
  value String
}

model Newsletter {
  id             String    @id @default(cuid())
  phone          String?   @unique
  email          String?
  couponCode     String    @unique
  usedAt         DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
}

model Promotion {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)
  /// "all" = every condition must hold (AND) · "any" = one is enough (OR)
  conditionLogic String  @default("all")
  /// true = once this promotion discounts a product, no other promotion may
  /// discount that same product in the same cart. Safe default: it is what
  /// stops several overlapping offers from gutting one item's price.
  exclusive      Boolean @default(true)
  /// "rules"   = the conditions + rewards below
  /// "bundle"  = buyQuantity items from the "buy" list for bundlePrice (3 for ₪200)
  /// "buy_get" = buy buyQuantity from the "buy" list, get getQuantity from the
  ///             "get" list at getDiscountPct off (100 = free)
  kind            String  @default("rules")
  buyQuantity     Int?
  bundlePrice     Int?
  getQuantity     Int?
  getDiscountPct  Int?
  /// bundle / buy_get: how many times it applies per cart; null = no limit
  maxApplications Int?
  /// A tag on the product cards of every product this promotion covers.
  /// badgeText null = a text worked out from the offer ("2 ב-₪299").
  badgeEnabled  Boolean @default(false)
  badgeText     String?
  badgeColor    String  @default("#1E6B3C")
  /// "sm" | "md" | "lg"
  badgeSize     String  @default("md")
  /// "top-right" | "top-left" | "bottom-right" | "bottom-left"
  badgePosition String  @default("bottom-left")
  createdAt      DateTime             @default(now())
  conditions     PromotionCondition[]
  rewards        PromotionReward[]
  items          PromotionItem[]
}

/// One entry in a bundle / buy_get list: a whole category or a single product.
/// Categories are resolved when a cart is priced, so products added to the
/// category later are covered without editing the promotion.
model PromotionItem {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  role        String    // "buy" | "get"
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([promotionId])
}

model PromotionCondition {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type        String    // "min_cart_total" | "product_in_cart"
  productId   String?
  minTotal    Float?
}

model PromotionReward {
  id             String    @id @default(cuid())
  promotionId    String
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type           String    // "free_shipping" | "cart_discount" | "product_discount"
  productId      String?
  discountPct    Int?
  discountAmount Int?
  maxUnits       Int?      // product_discount: units the discount reaches; null = every unit in the cart
  /// free_shipping: which delivery it makes free — "all" | "home" | "epost" (pickup point).
  /// null = "all", which is what free-shipping promotions did before the choice existed.
  shippingScope  String?
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountPct    Int?
  discountAmount Int?
  /// A free-shipping coupon instead of a discount: which delivery it makes free.
  /// "all" = home and pickup point · "home" · "epost" (pickup point) · null = a discount coupon
  freeShipping   String?
  singleUse      Boolean   @default(true)
  usedByEmail    String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  usedAt         DateTime?
  /// A content creator's code: every paid order that used it is credited to
  /// the creator, even when a promotion meant it gave no extra discount.
  collab         Boolean   @default(false)
  collabName     String?
  /// Commission, as a percent of the order's items after every discount (delivery excluded).
  collabPct      Float?
  /// Texted the customer's name, the amount and the commission on every paid order.
  collabPhone    String?
  payouts        CollabPayout[]
}

/// Money paid out to a creator against their code's commission. The orders
/// stay as they are; the balance due is what they earned minus these.
model CollabPayout {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  amount    Float
  createdAt DateTime @default(now())

  @@index([couponId])
}
